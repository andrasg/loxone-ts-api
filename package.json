{
  "name": "loxone-ts-api",
  "version": "1.4.0",
  "description": "TypeScript client for the Loxone API",
  "type": "module",
  "main": "dist/LoxoneClient.js",
  "types": "dist/LoxoneClient.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc --build tsconfig.build.json",
    "buildProduction": "tsc --project tsconfig.build.production.json",
    "typecheck": "tsc --build tsconfig.json --noEmit",
    "start": "node dist/workbench.js",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrasg/loxone-ts-api.git"
  },
  "keywords": [
    "loxone",
    "api",
    "typescript"
  ],
  "author": "Andras Gaal",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "dependencies": {
    "node-ansi-logger": "^3.3.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/ws": "^8.18.1",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
